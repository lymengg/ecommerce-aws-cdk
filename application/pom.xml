<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.ecommerce</groupId>
  <artifactId>ecommerce-api</artifactId>
  <version>0.1.0</version>
  <name>ecommerce-api</name>
  <description>Spring Boot product API backed by PostgreSQL for the e-commerce platform</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- REST controllers and the embedded servlet container. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- /actuator/health, which the Application Load Balancer health check calls. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Spring Data JPA on Hibernate: the Product entity, the repository and the transaction
      management that the service layer relies on.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Jakarta Bean Validation, used by the request DTO annotations (@NotBlank, @Positive, ...). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      OAuth 2.0 / OIDC client support (Phase 4). The application is the OAuth client of the Cognito
      user pool: it runs the authorization code + PKCE flow server side, holds the tokens itself,
      and gives the browser only an httpOnly session cookie (the Backend for Frontend pattern).

      Deliberately NOT spring-boot-starter-oauth2-resource-server: this phase authenticates browser
      users through a session, not bearer tokens. Resource-server support for future mobile or
      service clients is a later, additive phase - see the README.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <!--
      Flyway owns the schema. The application never creates or alters a table itself: it validates
      the entities against what Flyway has already migrated, so a mismatch fails the deployment
      instead of the first query.

      Spring Boot 4 modularised its auto-configuration, so the Flyway auto-configuration now lives
      in spring-boot-flyway rather than in spring-boot-autoconfigure: flyway-core alone would be on
      the classpath without ever being wired up. The dialect module is still required separately,
      because Flyway 10+ moved database support out of the core jar.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- PostgreSQL JDBC driver. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Spring Boot 4 modularised its test support: MockMvc auto-configuration (@AutoConfigureMockMvc)
      and the MVC test slice live in this companion starter rather than in spring-boot-starter-test.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Spring Security test support: the request post-processors (user(), csrf()) and result matchers
      the security tests use to simulate an authenticated browser session without a real Cognito.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      The tests run against a real PostgreSQL, not an in-memory stand-in: H2 does not enforce the
      same constraints, does not speak the same dialect, and would happily pass a schema Flyway
      could never create. The container image matches the major version the database stack deploys.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Produces the executable, self-contained jar the container image runs. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
