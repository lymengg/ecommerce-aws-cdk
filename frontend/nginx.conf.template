# Rendered by the image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf, so
# ${API_ORIGIN} is substituted from the container environment at start - the image itself is
# environment-agnostic.
server {
    # nginx-unprivileged listens on 8080; the target group forwards here.
    listen       8080;
    server_name  _;

    # `$csp_script_hashes`, set by the file the build writes: the sha256 of each inline script in the
    # app shell. Included here so the policy below can name them.
    include /etc/nginx/script-hashes.conf;

    root  /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version in responses or error pages.
    server_tokens off;

    # Nothing served here is large; a body limit keeps an accidental upload from being buffered.
    client_max_body_size 1m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers (OWASP A05). HSTS is deliberately *not* here: it is set on the load balancer
    # listener, which also covers the port 80 redirect this service never sees.
    #
    # `always` makes the headers apply to error responses too. Note that adding an `add_header` in a
    # nested block would discard these - which is why the cache locations below use `expires`, not
    # `add_header`.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    #
    # `script-src` allows the app shell's own inline scripts by hash - never 'unsafe-inline', which
    # would let any injected script run. The hashes are computed by the build (scripts/csp-hashes.mjs)
    # because two of those scripts change on every build.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${API_ORIGIN}; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' $csp_script_hashes; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Health probe answered by nginx itself: a broken bundle cannot make the task look unhealthy, and
    # a broken nginx cannot look healthy. `default_type` rather than `add_header` so the security
    # headers above still apply.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build assets are immutable: the file name changes when the content does, so they can be
    # cached for a year.
    location /_nuxt/ {
        expires 1y;
        try_files $uri =404;
    }

    # The app shell must never be cached, or a deployment would not be picked up.
    location = /index.html {
        expires -1;
    }

    # A client-side route has no file on disk, so fall back to the app shell and let the router take
    # over. This is the one thing an SPA needs from its web server.
    #
    # `$uri/` is deliberately absent: the static build contains a directory per prerendered route, so
    # testing for one would make nginx answer `/cart` with a 301 to `/cart/`. A client-side route
    # should be served directly, with no redirect, and every prerendered shell is identical anyway
    # (this app is client-rendered).
    location / {
        try_files $uri /index.html;
    }
}
