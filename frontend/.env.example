# Copy to `.env` for local development. Nuxt loads it in dev only.
#
# The Spring API's base URL. Locally that is the API running on 8080; the storefront itself runs on
# 5173, which is already on the dev environment's CORS allowlist, so the browser talks to the API
# cross-origin exactly as it does in production (apex -> api.<env-domain>).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
